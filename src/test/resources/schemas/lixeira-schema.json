
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "lixeiraId",
    "tipoResiduo",
    "capacidadeMaxima",
    "nivelAtual",
    "status",
    "localizacaoId",
    "nomeLocalizacao"
  ],
  "properties": {
    "lixeiraId": {
      "type": "integer"
    },
    "tipoResiduo": {
      "type": "string"
    },
    "capacidadeMaxima": {
      "type": "number"
    },
    "nivelAtual": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "DISPONIVEL",
        "QUASE_CHEIA",
        "CHEIA"
      ]
    },
    "localizacaoId": {
      "type": "integer"
    },
    "nomeLocalizacao": {
      "type": "string"
    }
  }
}
